PORT=

JWT_SECRET_KEY=

ADMIN_PASS_HASH=

SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_CLIPS_TABLE=movie_clips

USE_RCLONE_UPLOAD=false
RCLONE_REMOTE=cloudflare-r2
RCLONE_REMOTE_BASE_PATH=
STORAGE_PUBLIC_BASE_URL=
LOCAL_UPLOAD_ROOT=uploads/files
R2_BUCKET_NAME=

# Worker de Cloudflare como proxy de uploads (evita CORS con R2)
# Si estas variables estan presentes, /api/clips/upload-url devuelve una URL del Worker en vez de presigned URL de R2
WORKER_URL=
WORKER_SECRET=

# Variables para bootstrap automatico de rclone en servidor
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_S3_ENDPOINT=
R2_S3_ENDPOINT_EU=

# Ejemplo Cloudflare R2 + CDN
# USE_RCLONE_UPLOAD=true
